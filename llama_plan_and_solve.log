```python
import requests

# Define the API endpoints for Mite and Billomat
mite_api_endpoint = "https://api.mite.yo.lk/v2/"
billomat_api_endpoint = "https://api.billomat.com/v2/"

# Define the API keys for Mite and Billomat
mite_api_key = "YOUR_MITE_API_KEY"
billomat_api_key = "YOUR_BILLOMAT_API_KEY"

# Use the requests library to send a GET request to the Mite API
response = requests.get(mite_api_endpoint + "time_entries", headers={"Authorization": f"Bearer {mite_api_key}"})

# Parse the response data from Mite
time_entries = response.json()

# Loop through each time entry and create a new invoice in Billomat
for time_entry in time_entries:
    # Create a new invoice in Billomat using the Billomat API
    invoice_data = {
        "client_id": time_entry["client_id"],
        "date": time_entry["date"],
        "total": time_entry["total"]
    }
    response = requests.post(billomat_api_endpoint + "invoices", headers={"Authorization": f"Bearer {billomat_api_key}"}, json=invoice_data)

    # Check if the invoice was created successfully
    if response.status_code == 201:
        print("Invoice created successfully!")
    else:
        print("Error creating invoice:", response.text)
```
Note: This code is just a starting point and will likely require modification to work with your specific use case. You'll need to replace `YOUR_MITE_API_KEY` and `YOUR_BILLOMAT_API_KEY` with your actual API keys, and modify the `invoice_data` dictionary to match the structure of the Billomat API.
