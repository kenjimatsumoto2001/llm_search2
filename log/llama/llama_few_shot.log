```python
import requests

def get_artist_info(artist_name):
    # Use Lastfm API to get artist information
    lastfm_api_key = "YOUR_LASTFM_API_KEY"
    lastfm_url = f"http://ws.audioscrobbler.com/2.0/?method=artist.getinfo&artist={artist_name}&api_key={lastfm_api_key}&format=json"
    response = requests.get(lastfm_url)
    artist_info = response.json()
    return artist_info

def get_lyrics(song_title, artist_name):
    # Use Lyricsfly API to get song lyrics
    lyricsfly_api_key = "YOUR_LYRICSFLY_API_KEY"
    lyricsfly_url = f"https://api.lyricsfly.com/lyrics/{song_title}/{artist_name}?api_key={lyricsfly_api_key}"
    response = requests.get(lyricsfly_url)
    lyrics = response.json()
    return lyrics

def get_music_video(song_title, artist_name):
    # Use Youtube API to get music video
    youtube_api_key = "YOUR_YOUTUBE_API_KEY"
    youtube_url = f"https://www.googleapis.com/youtube/v3/search?q={song_title}+{artist_name}&part=snippet&type=video&key={youtube_api_key}"
    response = requests.get(youtube_url)
    video_info = response.json()
    return video_info

def get_artist_location(artist_name):
    # Use Google Maps API to get artist location
    google_maps_api_key = "YOUR_GOOGLE_MAPS_API_KEY"
    google_maps_url = f"https://maps.googleapis.com/maps/api/geocode/json?address={artist_name}&key={google_maps_api_key}"
    response = requests.get(google_maps_url)
    location_info = response.json()
    return location_info

# Example usage:
artist_name = "The Beatles"
song_title = "Yesterday"

artist_info = get_artist_info(artist_name)
lyrics = get_lyrics(song_title, artist_name)
video_info = get_music_video(song_title, artist_name)
location_info = get_artist_location(artist_name)

print("Artist Info:", artist_info)
print("Lyrics:", lyrics)
print("Video Info:", video_info)
print("Location Info:", location_info)
```
This example demonstrates how to use the recommended APIs to fetch artist information, song lyrics, music videos, and artist locations. Note that you need to replace the API keys with your own keys and handle errors and exceptions properly.
