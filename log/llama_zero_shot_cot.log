Here is a code snippet in python which uses box api to get the shared link for a file:
```python
import requests

def get_shared_link(file_id, access_token):
    headers = {
        'Authorization': f'Bearer {access_token}',
        'Content-Type': 'application/json'
    }
    url = f'https://api.box.com/2.0/files/{file_id}/shared_link'

    response = requests.get(url, headers=headers)

    if response.status_code == 200:
        return response.json()['shared_link']['url']
    else:
        return None

# Usage
access_token = 'your_access_token'
file_id = 'your_file_id'
shared_link = get_shared_link(file_id, access_token)
print(shared_link)
```
